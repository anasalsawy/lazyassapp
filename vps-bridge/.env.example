# Required
BRIDGE_API_KEY=your-strong-random-key-here

# Optional — for Browser Use agent mode
OPENAI_API_KEY=your-openai-key

# Optional — default proxy for all requests
# PROXY_SERVER=http://user:pass@proxy.example.com:8080

# Profiles storage
PROFILES_DIR=/opt/bridge/profiles

# Max concurrent browser sessions (1 for 2GB RAM, 2-3 for 4GB+)
MAX_CONCURRENT=1
