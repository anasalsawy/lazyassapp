[Unit]
Description=LazyAss VPS Browser Bridge
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=bridge
Group=bridge
WorkingDirectory=/opt/bridge
Environment=PROFILES_DIR=/opt/bridge/profiles
Environment=MAX_CONCURRENT=1
EnvironmentFile=/opt/bridge/.env
ExecStart=/opt/bridge/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/bridge/profiles
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
