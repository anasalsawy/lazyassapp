[
  {
    "name": "searchPlaces",
    "description": "Autocomplete airports and cities, returns IATA codes. Call this first to resolve city names.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "City or airport name, e.g. 'Cairo' or 'Houston'" }
      },
      "required": ["query"]
    }
  },
  {
    "name": "searchFlights",
    "description": "Search Duffel flight offers. Use IATA codes from searchPlaces.",
    "parameters": {
      "type": "object",
      "properties": {
        "slices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "origin": { "type": "string", "description": "IATA, e.g. IAH" },
              "destination": { "type": "string", "description": "IATA, e.g. CAI" },
              "departure_date": { "type": "string", "description": "YYYY-MM-DD" }
            },
            "required": ["origin", "destination", "departure_date"]
          }
        },
        "passengers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["adult", "child", "infant_without_seat"] }
            },
            "required": ["type"]
          }
        },
        "cabin_class": { "type": "string", "enum": ["economy", "premium_economy", "business", "first"] }
      },
      "required": ["slices", "passengers"]
    }
  },
  {
    "name": "getOfferDetails",
    "description": "Fetch full offer info including ancillary services (bags, seats) before booking.",
    "parameters": {
      "type": "object",
      "properties": { "offer_id": { "type": "string" } },
      "required": ["offer_id"]
    }
  },
  {
    "name": "getSeatMaps",
    "description": "Get seat maps for an offer.",
    "parameters": {
      "type": "object",
      "properties": { "offer_id": { "type": "string" } },
      "required": ["offer_id"]
    }
  },
  {
    "name": "createOrder",
    "description": "Book the offer. Creates a Duffel order, pays via Duffel balance, returns PNR.",
    "parameters": {
      "type": "object",
      "properties": {
        "offer_id": { "type": "string" },
        "passengers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "given_name": { "type": "string" },
              "family_name": { "type": "string" },
              "title": { "type": "string", "enum": ["mr", "mrs", "ms", "miss", "dr"] },
              "gender": { "type": "string", "enum": ["m", "f"] },
              "born_on": { "type": "string", "description": "YYYY-MM-DD" },
              "email": { "type": "string" },
              "phone_number": { "type": "string", "description": "E.164, e.g. +17134698336" }
            },
            "required": ["given_name", "family_name", "born_on", "gender", "email", "phone_number"]
          }
        },
        "selected_services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "quantity": { "type": "integer" }
            },
            "required": ["id", "quantity"]
          }
        }
      },
      "required": ["offer_id", "passengers"]
    }
  },
  {
    "name": "listOrders",
    "description": "List existing Duffel bookings.",
    "parameters": { "type": "object", "properties": {} }
  },
  {
    "name": "getOrder",
    "description": "Get full details for one booking.",
    "parameters": {
      "type": "object",
      "properties": { "order_id": { "type": "string" } },
      "required": ["order_id"]
    }
  },
  {
    "name": "cancelOrder",
    "description": "Cancel a booking. First call with confirm=false to quote refund, then confirm=true to execute.",
    "parameters": {
      "type": "object",
      "properties": {
        "order_id": { "type": "string" },
        "confirm": { "type": "boolean", "default": false }
      },
      "required": ["order_id"]
    }
  }
]
